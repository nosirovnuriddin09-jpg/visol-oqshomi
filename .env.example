# Visol Oqshomi - Telegram Mini App & Backend Configuration

# Server Port
PORT=3000

# Telegram Bot Token (obtain from @BotFather on Telegram)
# Example: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_TOKEN=your_telegram_bot_token_here

# Web App URL (the HTTPS URL where this app is hosted or tunneled via ngrok / localtunnel)
# Note: Telegram Mini Apps require HTTPS. For local testing without bot, open http://localhost:3000 directly.
WEBAPP_URL=https://your-telegram-miniapp-domain.com

# Optional: Admin Telegram Chat ID to receive instant alerts for every new registration
ADMIN_CHAT_ID=

# Event Details
EVENT_TITLE="Visol Oqshomi"
EVENT_DATE="2026-11-15 18:00"
EVENT_VENUE="Yulduzlar Qasri Grand Ball Hall, Toshkent"

# Click Payment Merchant Credentials
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Payme Payment Merchant Credentials
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
